{
  "name": "english-restaurant-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev-server.ps1",
    "dev:next": "next dev --turbo --hostname 127.0.0.1 --port 3000",
    "build": "next build && npm run audit:payload",
    "build:static": "npm run generate:redirects && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:NEXT_PUBLIC_SITE_URL='https://indianrestaurantlondon.co.uk'; $env:NEXT_STATIC_EXPORT='1'; next build\" && npm run audit:payload",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "audit:seo": "tsx scripts/check-seo-policy.ts",
    "audit:indexation": "tsx scripts/check-indexation-crawl.ts",
    "audit:links": "tsx scripts/check-internal-link-governance.ts",
    "audit:freshness": "tsx scripts/check-freshness.ts",
    "audit:template": "tsx scripts/check-template-readiness.ts",
    "audit:payload": "tsx scripts/check-client-payload.ts",
    "audit:dependencies": "tsx scripts/check-dependency-security.ts",
    "audit:listings": "tsx scripts/check-listing-operational-quality.ts",
    "audit:media": "tsx scripts/check-listing-media-quality.ts",
    "check:cloudflare": "tsx scripts/check-cloudflare-export.ts",
    "diagnose:static": "tsx scripts/static-export-diagnostics.ts",
    "generate:redirects": "tsx scripts/generate-cloudflare-redirects.ts",
    "prepare:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-cloudflare-upload.ps1",
    "publish:cloudflare": "tsx scripts/publish-cloudflare.ts",
    "import:directory": "tsx scripts/import-directory.ts",
    "resolve:listing-entities": "tsx scripts/resolve-listing-entities.ts",
    "backfill:listing-provenance": "tsx scripts/backfill-listing-provenance.ts",
    "backfill:listing-media": "tsx scripts/backfill-listing-media-provenance.ts",
    "quarantine:listing-media": "tsx scripts/quarantine-unapproved-listing-media.ts",
    "enrich:outscraper-media": "tsx scripts/enrich-outscraper-media.ts",
    "article:duplicates": "tsx scripts/article-duplicate-report.ts",
    "article:next-planned": "tsx scripts/article-next-planned.ts",
    "article:research": "tsx scripts/article-live-research.ts",
    "article:create-draft": "tsx scripts/article-create-draft.ts",
    "article:next-draft": "tsx scripts/article-next-draft.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/supercluster": "^7.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
