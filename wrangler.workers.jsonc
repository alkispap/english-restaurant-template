{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indianrestaurantlondon-workers",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "indianrestaurantlondon.co.uk/*",
      "zone_id": "20559aa05b8550e8c992c962369a7d1b"
    },
    {
      "pattern": "www.indianrestaurantlondon.co.uk/*",
      "zone_id": "20559aa05b8550e8c992c962369a7d1b"
    }
  ],
  "assets": {
    "directory": "./out"
  }
}
